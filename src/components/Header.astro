<header class="site-header">
  <div class="site-header__inner glass">
    <a class="site-header__brand" href="/" aria-label="Portfolio home">
      NM
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-controls="site-navigation"
      aria-expanded="false"
    >
      <span class="menu-toggle__label">メニュー</span>
      <span class="menu-toggle__icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <nav
      id="site-navigation"
      class="site-navigation"
      aria-label="Main navigation"
    >
      <ul class="site-nav">
        <!-- <li>
          <a href="/">Home</a>
        </li> -->
        <li>
          <a href="/#about">
            <span>私について</span>
            <!-- <span>About</span> -->
          </a>
        </li>
        <li>
          <a href="/#skills">
            <span>テクニカルスキル</span>
            <!-- <span>Skills</span> -->
          </a>
        </li>
        <li>
          <a href="/#works">
            <span>開発履歴</span>
            <!-- <span>Works</span> -->
          </a>
        </li>
        <li>
          <a href="/#contact">
            <span>お問い合わせ</span>
            <!-- <span>Contact</span> -->
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style lang="scss">
  @use '../styles/base' as *;
  @use '../styles/breakpoints' as breakpoint;

  @keyframes header-shrink {
    from {
      margin-top: 0;
      max-width: 100%;
      border-radius: 0;
      box-shadow: 0 0 0 rgb(15 23 42 / 0%);
    }

    to {
      margin-top: 16px;
      max-width: var(--header-shrink-width);
      border-radius: var(--radius-infinite);
      box-shadow: 0 0.75rem 1.5rem rgb(15 23 42 / 12%);
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    isolation: isolate;

    &__inner {
      --header-shrink-width: 40rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: 1;
      width: 100%;
      // max-width: 72rem;
      min-height: 2rem;
      margin: 0 auto;
      padding-inline: 1.5rem;
      border-radius: 0;
      background: var(--color-background);

      @media (max-width: breakpoint.$mobile) {
        --header-shrink-width: calc(100% - 4rem);
        min-height: 1rem;
        padding-inline: 1rem;
      }
    }

    &__brand {
      @extend .grape-nuts-regular;
      color: var(--color-text);
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-decoration-line: underline;
      text-decoration-color: transparent;
      text-underline-offset: 0.25em;

      &:hover,
      &:focus-visible {
        text-decoration-color: currentColor;
      }
    }
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    background: transparent;
    cursor: pointer;

    &__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    &__icon {
      display: grid;
      gap: 0.3rem;
      width: 1.5rem;

      span {
        display: block;
        height: 1px;
        border-radius: var(--radius-infinite);
        background: currentColor;
        transition:
          transform calc(var(--transition-duration) + 0.4s) ease,
          opacity calc(var(--transition-duration) + 0.4s) ease;
      }
    }

    &[aria-expanded='true'] {
      .menu-toggle__icon span {
        position: relative;
        &:nth-child(1) {
          top: -2px;
          transform: translateY(0.5rem) rotate(45deg);
        }

        &:nth-child(2) {
          opacity: 0;
        }

        &:nth-child(3) {
          top: 2px;
          transform: translateY(-0.5rem) rotate(-45deg);
        }
      }
    }
  }

  @supports (animation-timeline: scroll()) {
    .site-header__inner {
      animation: header-shrink cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-timeline: scroll(root block);
      animation-range: 0 160px; // Adjust the scroll range for the header shrink animation
    }
  }

  .site-nav {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    list-style: none;

    // @media (max-width: breakpoint.$mobile) {
    //   gap: 0.5rem;
    // }

    a {
      position: relative;
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
      color: inherit;
      text-decoration-line: none;
      // text-decoration-line: underline;
      text-decoration-color: transparent;
      text-underline-offset: 0.25em;
      border-radius: var(--radius-infinite);
      background-color: transparent;

      &:hover,
      &:focus-visible {
        text-decoration-color: currentColor;
      }

      &[aria-current='location'] {
        color: var(--color-white);
        font-weight: 700;
        background-color: var(--color-text);

        // &::after {
        //   --dot-size: 3px;
        //   margin-block: auto;
        //   content: '';
        //   position: absolute;
        //   inset-inline: 0;
        //   top: 0;
        //   bottom: 0;
        //   left: 0.375rem;
        //   width: var(--dot-size);
        //   height: var(--dot-size);
        //   border-radius: var(--radius-infinite);
        //   background: var(--color-white);
        // }
      }
    }
  }

  @media (max-width: breakpoint.$mobile) {
    .menu-toggle {
      display: inline-flex;
    }

    .site-navigation {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      left: 0;
      display: none;
      padding: 0.5rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-background);
      box-shadow: 0 0.75rem 1.5rem rgb(15 23 42 / 12%);

      ul {
        display: grid;
        gap: 0.25rem;
      }

      a {
        display: block;
        min-height: 2.75rem;
        padding: 0.625rem 0.75rem;
        border-radius: var(--radius-sm);

        &:hover,
        &:focus-visible {
          background: var(--color-surface);
          text-decoration: none;
        }

        &[aria-current='location'] {
          background: var(--color-accent-soft);

          &::after {
            display: none;
          }
        }
      }

      &[data-open='true'] {
        display: block;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__icon span {
      transition: none;
    }
  }

  .glass {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(16px);
    transition: backdrop-filter 240ms ease;
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const siteNavigation =
    document.querySelector<HTMLElement>('#site-navigation');

  if (menuToggle && siteNavigation) {
    const closeMenu = () => {
      menuToggle.setAttribute('aria-expanded', 'false');
      siteNavigation.removeAttribute('data-open');
    };

    const openMenu = () => {
      menuToggle.setAttribute('aria-expanded', 'true');
      siteNavigation.setAttribute('data-open', 'true');
      siteNavigation.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    menuToggle.addEventListener('click', () => {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    siteNavigation.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        menuToggle.getAttribute('aria-expanded') === 'true'
      ) {
        closeMenu();
        menuToggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;

      if (
        menuToggle.getAttribute('aria-expanded') === 'true' &&
        !menuToggle.contains(target) &&
        !siteNavigation.contains(target)
      ) {
        closeMenu();
      }
    });

    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 768px)').matches) {
        closeMenu();
      }
    });
  }

  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('main [id]'),
  );
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href*="#"]'),
  );

  if (sections.length && navLinks.length && 'IntersectionObserver' in window) {
    const linkBySectionId = new Map<string, HTMLAnchorElement>();
    navLinks.forEach((link) => {
      const id = link.getAttribute('href')?.split('#')[1];
      if (id) linkBySectionId.set(id, link);
    });

    const setActiveLink = (id: string | null) => {
      navLinks.forEach((link) => link.removeAttribute('aria-current'));
      if (id) linkBySectionId.get(id)?.setAttribute('aria-current', 'location');
    };

    // ヘッダーの高さ分だけ判定領域を下にずらす
    const headerHeight =
      document.querySelector('.site-header')?.getBoundingClientRect().height ??
      0;

    // 現在ヘッダー直下の帯に入っているセクション id の集合
    const visibleSectionIds = new Set<string>();

    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            visibleSectionIds.add(entry.target.id);
          } else {
            visibleSectionIds.delete(entry.target.id);
          }
        });

        const activeSection = sections.find((section) =>
          visibleSectionIds.has(section.id),
        );

        setActiveLink(activeSection?.id ?? null);
      },
      {
        // ヘッダー直下に細い判定帯を作り、常に1セクションだけ拾う
        rootMargin: `-${headerHeight + 24}px 0px -70% 0px`,
        threshold: 0,
      },
    );

    sections.forEach((section) => sectionObserver.observe(section));
  }
</script>
