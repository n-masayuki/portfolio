---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'ul'> {
  items: {
    label: string;
    icon?: { hex: string; path: string };
    color?: string;
  }[];
}

const { items, ...attributes } = Astro.props;
---

<ul {...attributes}>
  {items.map(({ icon, label, color }) => (
    <li
      style={
        color || icon
          ? `--brand-color: ${color ?? (icon ? `#${icon.hex}` : undefined)}`
          : undefined
      }
    >
      {icon && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={icon.path} fill="currentColor" />
        </svg>
      )}
      <span>{label}</span>
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    align-self: start;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    font-size: var(--font-size-xxs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-infinite);
    color: var(--brand-color, var(--color-gray-600));
    background-color: var(--color-white);
  }

  svg {
    width: 1rem;
    height: 1rem;
  }

  span {
    color: var(--color-text);
  }
</style>
