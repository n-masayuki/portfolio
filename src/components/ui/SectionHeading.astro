---
interface Props {
  id: string;
  title: string;
  english: string;
}

const { id, title, english } = Astro.props;
---

<div class="section-heading">
  <div class="section-heading__ja-en-wrapper">
    <h2 id={id} class="section-heading__ja">
      {title}
    </h2>
    <p class="section-heading__en" aria-hidden="true">
      {english}
    </p>
  </div>
</div>
