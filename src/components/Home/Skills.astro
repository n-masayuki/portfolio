---
import type { ComponentProps } from 'astro/types';
import TechnologyList from '../ui/TechnologyList.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import {
  siAstro,
  siCss,
  siSass,
  siFigma,
  siGit,
  siGithub,
  siGithubcopilot,
  siPrettier,
  siPhp,
  siEslint,
  siHtml5,
  siJavascript,
  siReact,
  siTypescript,
  siWebpack,
  siGsap,
  siSwiper,
  siWordpress,
  siLottiefiles,
  siGooglegemini,
  siGoogleanalytics,
  siGoogletagmanager,
  siNpm,
  siVite,
  siClaude,
} from 'simple-icons';

type Skill = ComponentProps<typeof TechnologyList>['items'][number];

// フロントエンド
const frontSkills: Skill[] = [
  { icon: siHtml5, label: 'HTML' },
  { icon: siCss, label: 'CSS' },
  { icon: siSass, label: 'Sass' },
  { icon: siJavascript, label: 'JavaScript' },
  { icon: siTypescript, label: 'TypeScript' },
  { icon: siReact, label: 'React' },
  { icon: siAstro, label: 'Astro' },
];

// CMS・EC
const cmsSkills: Skill[] = [
  { icon: siPhp, label: 'PHP' },
  { icon: siWordpress, label: 'WordPress' },
  { label: 'ecbeing' },
  { label: 'makeshop by GMO' },
  { label: 'etc.' },
];

// インタラクション
const interactionSkills: Skill[] = [
  { label: 'CSS Animation' },
  { icon: siGsap, label: 'GSAP' },
  { icon: siLottiefiles, label: 'LottieFiles' },
  { icon: siSwiper, label: 'Swiper' },
  { label: 'Splide', color: '#ff4154' },
  { label: 'MicroModal' },
  { label: 'etc.' },
];

// 品質管理・開発支援
const qualitySkills: Skill[] = [
  { icon: siGit, label: 'Git' },
  { icon: siGithub, label: 'GitHub' },
  { icon: siNpm, label: 'npm' },
  { icon: siVite, label: 'Vite' },
  { icon: siWebpack, label: 'webpack' },
  { icon: siEslint, label: 'ESLint' },
  { icon: siPrettier, label: 'Prettier' },
  { label: 'etc.' },
];

// デザイン・分析
const designSkills: Skill[] = [
  { icon: siFigma, label: 'Figma' },
  { label: 'Photoshop' },
  { label: 'Illustrator' },
  { label: 'Adobe XD' },
  { icon: siGoogleanalytics, label: 'GA4' },
  { icon: siGoogletagmanager, label: 'Google Tag Manager' },
];

// AI活用
const aiSkills: Skill[] = [
  { label: 'ChatGPT' },
  { label: 'Codex' },
  { icon: siClaude, label: 'Claude' },
  { icon: siGithubcopilot, label: 'GitHub Copilot' },
  { icon: siGooglegemini, label: 'Google Gemini' },
  { label: 'etc.' },
];
---

<section id="skills" class="section skills" aria-labelledby="skills-heading">
  <SectionHeading
    id="skills-heading"
    title="テクニカルスキル"
    english="Skills"
  />

  <p class="intro">
    Webサイトの設計・実装から運用、改善まで、目的と環境に合わせて継続的に取り組んできました。
  </p>

  <div class="skills-grid">
    <article class="skill-card">
      <h3>
        <span>フロントエンド</span>
        <span aria-hidden="true">Frontend</span>
      </h3>
      <TechnologyList class="skill-list" items={frontSkills} />
      <p>
        セマンティックなマークアップ、レスポンシブ設計、CSS
        Grid・Flexbox、既存コードの改修や共通化に対応します。
      </p>
    </article>

    <article class="skill-card">
      <h3>
        <span>CMS・EC</span>
        <span aria-hidden="true">CMS &amp; EC</span>
      </h3>
      <TechnologyList class="skill-list" items={cmsSkills} />
      <p>
        WordPressのテーマ制作やPHPの改修、ECサイトのフロントエンド実装・運用、管理画面の設定を担当してきました。
      </p>
    </article>

    <article class="skill-card">
      <h3>
        <span>インタラクション</span>
        <span aria-hidden="true">Interaction</span>
      </h3>
      <TechnologyList class="skill-list" items={interactionSkills} />
      <p>
        目的に応じてCSSとJavaScriptを使い分け、UIの操作感やページの演出を実装します。
      </p>
    </article>

    <article class="skill-card">
      <h3>
        <span>品質・開発環境</span>
        <span aria-hidden="true">Quality &amp; Workflow</span>
      </h3>
      <TechnologyList class="skill-list" items={qualitySkills} />
      <p>
        アクセシビリティ、アクセス解析、Lighthouseによる改善を意識し、レビューと保守性を含めて開発します。
        <br />
        また、ビルド環境の整備、Lint・フォーマットによるコード品質の維持に対応します。
      </p>
    </article>

    <article class="skill-card">
      <h3>
        <span>デザイン・分析</span>
        <span aria-hidden="true">Design &amp; Analysis</span>
      </h3>
      <TechnologyList class="skill-list" items={designSkills} />
      <p>
        ワイヤーフレームやUI設計、顧客との仕様調整から、公開後の分析と改善まで対応します。
      </p>
    </article>

    <article class="skill-card">
      <h3>
        <span>AI活用</span>
        <span aria-hidden="true">AI-assisted Development</span>
      </h3>
      <TechnologyList class="skill-list" items={aiSkills} />
      <p>
        設計検討、デバッグ、リファクタリング、テスト、ドキュメント作成の補助に活用し、内容を確認してから採用します。
      </p>
    </article>
  </div>
</section>

<style lang="scss">
  @use '../../styles/base' as *;
  @use '../../styles/breakpoints' as breakpoint;

  #skills {
    .skills-grid {
      margin-top: 2rem;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      @media (max-width: breakpoint.$mobile) {
        grid-template-columns: 1fr;
      }
    }

    .skill-card {
      padding: 1.5rem;
      border-radius: var(--radius-xl);
      background: var(--color-white);

      h3 {
        margin-bottom: 0.75rem;
        font-size: 1rem;
        line-height: 1.2;

        @media (max-width: breakpoint.$mobile) {
          display: grid;
          gap: 0.5rem;
        }

        span {
          &[aria-hidden='true'] {
            @extend .grape-nuts-regular;
            margin-inline-start: 1rem;
            color: var(--color-gray-400);
            font-size: 1rem;
            font-weight: 400;
            letter-spacing: 0.04em;

            @media (max-width: breakpoint.$mobile) {
              margin-inline-start: 0;
            }
          }
        }
      }

      p {
        margin: 0;
        font-size: 0.75rem;
        line-height: 1.7;

        & + p {
          margin-top: 0.75rem;
          font-size: 0.75rem;
        }
      }

      .skill-list + p {
        margin-top: 1rem;
      }
    }
  }
</style>
