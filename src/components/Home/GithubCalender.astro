---
import { GitHubCalendar } from 'react-github-calendar';
---

<div id="github-calendar" class="github-calendar" data-reveal>
  <h3>GitHub Contributions</h3>
  <GitHubCalendar
    client:only="react"
    username="n-masayuki"
    colorScheme="light"
    fontSize={12}
    blockSize={12}
  />
</div>

<script>
  import { initCalendarFade } from '../../scripts/calendar';

  // ページ内に一つだけあるカレンダーのスクロール案内を初期化する。
  initCalendarFade(document.getElementById('github-calendar'));
</script>

<style lang="scss">
  @use '../../styles/base' as *;
  @use '../../styles/breakpoints' as breakpoint;

  .github-calendar {
    position: relative;
    --title-line-height: 1.2;
    --title-height: calc(var(--font-size-md) * var(--title-line-height));
    --title-margin-bottom: 0.75rem;
    --footer-height: calc(var(--font-size-xs) * 1.7);
    --calendar-gap: 8px;
    --react-activity-calendar-height: 130px;

    margin-block-start: 3rem;
    height: calc(
      var(--title-height) + var(--title-margin-bottom) +
        var(--react-activity-calendar-height) + var(--calendar-gap) +
        var(--footer-height)
    );
  }

  h3 {
    margin-bottom: var(--title-margin-bottom);
    font-size: var(--font-size-md);
    line-height: var(--title-line-height);
  }

  :global(svg) {
    max-width: max-content;
  }

  :global(.react-activity-calendar__scroll-container[data-overflow-right]) {
    // 右に続きがある場合だけフェードする
    mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(100% - 32px),
      transparent 100%
    );
  }
</style>
