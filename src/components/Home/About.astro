---
import { Image } from 'astro:assets';
import portrait from '../../assets/home/portrait.webp';

const careerStartYear = 2008;
const careerOffset = 1;
const experienceYears =
  new Date().getFullYear() - careerStartYear - careerOffset;
---

<section id="about" class="section about" aria-labelledby="about-heading">
  <div class="section-heading">
    <!-- <p class="eyebrow">About Me</p> -->
    <div class="section-heading__ja-en-wrapper">
      <h2 id="about-heading" class="section-heading__ja">
        私について
      </h2>
      <p class="section-heading__en" aria-hidden="true">
        About
      </p>
    </div>
  </div>

  <figure class="avatar">
    <Image src={portrait} alt="プロフィール画像" loading="lazy" />
    <figcaption>Niibori Masauyki</figcaption>
  </figure>

  <p class="intro">
    約{experienceYears}
    年間、Webサイトの企画・制作・開発・運用に従事してきました。
    <br />
    HTML /
    CSSを用いたWebサイト制作を強みとし、JavaScript、React、PHP、WordPressを用いたフロントエンド開発・CMS構築にも携わっています。
    <br />
    <br />
    近年は既存サイトのリファクタリングやReactへの段階的な移行、表示パフォーマンス・アクセシビリティの改善、GA4
    /
    GTM等を利用した計測環境の整備など、継続的なサイト改善に取り組んできました。
    <br />
    大手上場企業のコーポレートサイトやブランドサイトをはじめ、ECサイト、商業施設のキャンペーンサイト、芸能関連サイトなど幅広い制作・運用経験があります。
    <br />
    <br />
    Webデザイン、フロントエンド開発、Webディレクションの各業務を経験しており、デザインや要件を踏まえた実装判断が可能です。Web領域を主担当として、案件規模に応じて外部エンジニアやコーダー、ベンダーと連携しながらプロジェクトを進行してきました。
  </p>
</section>

<style lang="scss">
  @use '../../styles/base' as *;
  @use '../../styles/breakpoints' as breakpoint;

  #about {
    position: relative;

    @media (max-width: breakpoint.$mobile) {
      --_m: max(0px, calc((100vw - 800px) / 2));
      margin-inline: calc(-1 * var(--_m));
      width: calc(100% + var(--_m) * 2);
    }

    &::before {
      @extend .grape-nuts-regular;
      content: 'NM';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: clamp(32rem, 20vw, 200rem);
      text-align: center;
      // color: var(--color-white);
      color: rgba(255, 255, 255, 0.6);
      white-space: nowrap;
      pointer-events: none;
      user-select: none;
    }
  }

  :global(.site-shell) {
    overflow-x: clip;
  }

  .avatar {
    position: relative;
    float: left;
    width: clamp(80px, 16vw, 160px);
    margin: 0 2rem 1rem 0;
    shape-outside: inset(0 round 1.25rem);

    @media (max-width: breakpoint.$mobile) {
      margin-right: 1rem;
    }

    figcaption {
      margin-top: 0.5rem;
      text-align: center;
      color: var(--color-text);
      font-size: var(--font-size-xs);
      line-height: 1.4;
    }

    img {
      display: block;
      width: 100%;
      height: auto;
      // aspect-ratio: 3 / 4;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      // border-radius: var(--radius-xl);
      border-radius: 58% 42% 72% 28% / 32% 65% 35% 68%;
      background-color: var(--color-surface);

      @media (max-width: breakpoint.$mobile) {
        aspect-ratio: 3 / 4;
        // border-radius: var(--radius-lg);
        border-radius: 58% 42% 72% 28% / 32% 65% 35% 68%;
      }
    }
  }

  .intro {
    text-wrap: pretty;
  }
</style>
