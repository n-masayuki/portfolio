        rgba(100, 151, 252, 0.2) 0%,
        rgba(255, 255, 255, 0) 20%,
        rgba(255, 255, 255, 0) 80%,
        rgba(208, 27, 99, 0.2) 100%
      );
      pointer-events: none;
    }

    &[open] {
      display: grid;
      place-items: center;
      animation: splash-exit 400ms ease-in 1600ms forwards;

      .splash__identity {
        animation: splash-enter 700ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
