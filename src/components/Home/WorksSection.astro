---
import type { CollectionEntry } from 'astro:content';

interface Props {
  works: CollectionEntry<'works'>[];
}
const { works } = Astro.props;
const renderedWorks = works.map((work) => ({
  work,
  html: (work.rendered?.html ?? '').replace(/<h2\s+id="[^"]*">/g, '<h2>'),
}));
---

<section id="works" class="section" aria-labelledby="works-heading">
  <div class="section-heading">
    <!-- <p class="eyebrow">Portfolio</p> -->
    <div class="section-heading__ja-en-wrapper">
      <h2 id="works-heading" class="section-heading__ja">
        開発履歴
      </h2>
      <p class="section-heading__en" aria-hidden="true">
        Works
      </p>
    </div>
  </div>

  <p class="intro">これまでに携わったWebサイトの制作・開発実績を紹介します。</p>

  <div class="works-list">
    {renderedWorks.map(({ work }) => (
      <article class="work" id={`work-${work.id}`}>
        <button
          class="work__trigger"
          type="button"
          aria-haspopup="dialog"
          aria-controls={`work-modal-${work.id}`}
          aria-label={`${work.data.title}の詳細を見る`}
          data-open-modal={`work-modal-${work.id}`}
        >
          <span class="work__thumbnail">
            {work.data.thumbnail ? (
              <img
                src={work.data.thumbnail}
                alt={`${work.data.title}のサムネイル`}
                loading="lazy"
              />
            ) : (
              <span class="work__placeholder" aria-hidden="true">
                <span>port</span>
                <span>folio</span>
              </span>
            )}
          </span>
          <span class="work__body">
            <p class="work__category">{work.data.category}</p>
            <h3>{work.data.title}</h3>
            <p class="work__period">{work.data.period}</p>
            <span class="work__cta" aria-hidden="true">
              詳細
            </span>
          </span>
        </button>
      </article>
    ))}
  </div>

  {renderedWorks.map(({ work, html }) => (
    <dialog
      id={`work-modal-${work.id}`}
      class="work-modal"
      aria-labelledby={`work-modal-title-${work.id}`}
    >
      <div class="work-modal__inner">
        <button
          class="work-modal__close"
          type="button"
          data-close-modal
          aria-label="閉じる"
        >
          <span aria-hidden="true">&times;</span>
        </button>

        <header class="work__header">
          <p class="work__category">{work.data.category}</p>
          <h3 id={`work-modal-title-${work.id}`}>{work.data.title}</h3>
          {work.data.url && (
            <p class="work__url">
              <a href={work.data.url} target="_blank" rel="noopener noreferrer">
                {work.data.url}
              </a>
            </p>
          )}
          <p class="work__period">{work.data.period}</p>
        </header>

        <div class="work__meta">
          <div>
            <h4>担当領域</h4>
            <ul>
              {work.data.role.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div>
            <h4>使用技術</h4>
            <ul>
              {work.data.technologies.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="work__content">
          <Fragment set:html={html} />
        </div>
      </div>
    </dialog>
  ))}
</section>

<style lang="scss">
  @use '../../styles/base' as *;
  @use '../../styles/breakpoints' as breakpoint;

  #works {
    h3 {
      margin: 0.35rem 0;
      // font-size: clamp(1rem, 3vw, 1.5rem);
      font-size: 1.25rem;
    }

    h4 {
      margin: 0 0 0.5rem;
      font-size: 0.875rem;
    }

    .works-list {
      margin-top: 2rem;
      display: grid;
      gap: 2rem;
    }

    .work {
      border-radius: var(--radius-lg);
      background: var(--color-white);

      &__trigger {
        position: relative;
        display: flex;
        flex-direction: row-reverse;
        align-items: stretch;
        gap: 1.5rem;
        width: 100%;
        padding: 1.5rem;
        border: 0;
        border-radius: inherit;
        color: inherit;
        text-align: left;
        background: transparent;
        cursor: pointer;
        transition: background-color 200ms ease;

        @media (max-width: breakpoint.$mobile) {
          flex-direction: column;
          padding: 1.5rem;
        }

        &:hover,
        &:focus-visible {
          background-color: var(--color-surface);
        }
      }

      &__thumbnail {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 0 0 auto;
        width: 12rem;
        overflow: hidden;
        border: 1px solid var(--color-gray-100);
        border-radius: var(--radius-md);
        background-color: var(--color-surface);
        aspect-ratio: 4 / 3;

        @media (max-width: breakpoint.$mobile) {
          width: 100%;
          aspect-ratio: 16 / 9;
        }

        img {
          display: block;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }

      &__placeholder {
        display: flex;
        justify-content: center;
        align-items: center;

        span {
          @extend .montserrat-500;
          font-size: 1.25rem;
          // text-transform: uppercase;
          letter-spacing: 0.05em;

          @media (max-width: breakpoint.$mobile) {
            font-size: 2rem;
          }
          &:nth-child(1) {
            color: var(--color-gray-300);
            text-transform: capitalize;
          }
          &:nth-child(2) {
            color: var(--color-gray-200);
          }
        }
      }

      &__body {
        display: block;
        flex: 1 1 auto;
        min-width: 0;
      }

      &__cta {
        --size: 40px;
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 0.75rem;
        // padding: 0.5rem 0.875rem;
        width: var(--size);
        height: var(--size);
        border-radius: var(--radius-infinite);
        background-color: var(--color-gray-100);
        box-shadow: var(--box-shadow-sm);
        transition:
          color var(--color-transition-duration) ease,
          background-color var(--color-transition-duration) ease;

        @media (max-width: breakpoint.$mobile) {
          position: absolute;
          right: 0;
          bottom: 0;
          margin-right: calc(-1 * var(--size) / 4); // ネガティブマージン
          margin-bottom: calc(-1 * var(--size) / 4); // ネガティブマージン
        }

        &::before,
        &::after {
          display: block;
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          margin: auto;
          background-color: var(--color-gray-400);
          border-radius: 10px;
        }

        &::before {
          width: 1px;
          height: 16px;
        }
        &::after {
          width: 16px;
          height: 1px;
        }
      }

      &__header {
        margin-bottom: 1.5rem;
      }

      &__category,
      &__period,
      &__url {
        margin: 0;
        font-size: 0.75rem;
      }

      &__meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
        padding-block: 1.25rem;
        border-block: 1px solid var(--color-border);

        @media (max-width: breakpoint.$mobile) {
          grid-template-columns: 1fr;
        }

        ul {
          margin: 0;
          padding: 0;
          list-style: none;
          font-size: 0.75rem;
        }
        li {
          &::before {
            content: '';
            display: inline-block;
            width: 0.5rem;
            height: 1px;
            margin-inline-end: 0.5rem;
            vertical-align: middle;
            background-color: var(--color-gray-400);
          }
        }
      }

      &__content {
        :global(h2) {
          margin-top: 2rem;
          font-size: 0.875rem;
        }
        :global(p) {
          font-size: 0.75rem;
          line-height: 1.8;
        }
      }
    }

    .work-modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      width: min(100% - 2rem, 40rem);
      max-height: min(100% - 4rem, 48rem);
      margin: auto;
      padding: 0;
      border: 0;
      border-radius: var(--radius-lg);
      color: inherit;
      background: var(--color-white);
      box-shadow: 0 1.5rem 3rem rgb(15 23 42 / 24%);
      opacity: 0;
      transform: translateY(0.75rem) scale(0.97);
      transition:
        opacity 280ms ease,
        transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
        overlay 280ms allow-discrete,
        display 280ms allow-discrete;

      &[open] {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      @starting-style {
        &[open] {
          opacity: 0;
          transform: translateY(0.75rem) scale(0.97);
        }
      }

      &::backdrop {
        background-color: rgb(15 23 42 / 55%);
        backdrop-filter: blur(2px);
        opacity: 0;
        transition:
          opacity 280ms ease,
          overlay 280ms allow-discrete,
          display 280ms allow-discrete;
      }

      &[open]::backdrop {
        opacity: 1;
      }

      @starting-style {
        &[open]::backdrop {
          opacity: 0;
        }
      }

      &__inner {
        position: relative;
        max-height: inherit;
        padding: 2rem;
        overflow-y: auto;
      }

      &__close {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 0;
        border-radius: var(--radius-infinite);
        color: var(--color-text);
        font-size: 1.25rem;
        // line-height: 1;
        line-height: 1cap;
        background: var(--color-surface);
        cursor: pointer;

        &:hover,
        &:focus-visible {
          background: var(--color-border);
        }
      }
    }
  }
</style>

<script>
  // ダイアログを開閉するモーダル機能
  const openButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-open-modal]');

  openButtons.forEach((button) => {
    const dialogId = button.dataset.openModal;
    const dialog = dialogId ? document.getElementById(dialogId) : null;

    if (!(dialog instanceof HTMLDialogElement)) return;

    button.addEventListener('click', () => {
      dialog.showModal();
      document.body.classList.add('modal-open');
    });

    const closeButton =
      dialog.querySelector<HTMLButtonElement>('[data-close-modal]');
    closeButton?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      document.body.classList.remove('modal-open');
    });
  });
</script>

<style lang="scss" is:global>
  body.modal-open {
    overflow: hidden;
  }
</style>
