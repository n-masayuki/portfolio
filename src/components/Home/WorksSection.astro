---
import { Plus, ExternalLink, X } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  works: CollectionEntry<'works'>[];
}
const { works } = Astro.props;
const renderedWorks = works.map((work) => ({
  work,
  html: (work.rendered?.html ?? '').replace(/<h2\s+id="[^"]*">/g, '<h2>'),
}));
---

<section id="works" class="section" aria-labelledby="works-heading">
  <div class="section-heading">
    <div class="section-heading__ja-en-wrapper">
      <h2 id="works-heading" class="section-heading__ja">
        開発履歴
      </h2>
      <p class="section-heading__en" aria-hidden="true">
        Works
      </p>
    </div>
  </div>

  <p class="intro">これまでに携わったWebサイトの制作・開発実績を紹介します。</p>

  <div class="works-list">
    {renderedWorks.map(({ work }) => (
      <article class="work" id={`work-${work.id}`}>
        <div class="work__thumbnail">
          {work.data.thumbnail ? (
            <Image
              src={work.data.thumbnail}
              alt={`${work.data.title}のサムネイル`}
              loading="lazy"
            />
          ) : (
            <span class="work__placeholder" aria-hidden="true">
              <span>port</span>
              <span>folio</span>
            </span>
          )}
        </div>
        <div class="work__body">
          <ul class="work__category">
            {work.data.category.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <h3>{work.data.title}</h3>
          <p class="work__period">{work.data.period}</p>
        </div>
        <button
          class="work__trigger"
          type="button"
          aria-haspopup="dialog"
          aria-controls={`work-modal-${work.id}`}
          aria-label={`${work.data.title}の詳細を見る`}
          commandfor={`work-modal-${work.id}`}
          command="show-modal"
        >
          <span class="work__cta" aria-hidden="true">
            <Plus size={32} stroke-width={0.5} />
          </span>
        </button>
      </article>
    ))}
  </div>

  {renderedWorks.map(({ work, html }) => (
    <dialog
      id={`work-modal-${work.id}`}
      class="work-modal"
      closedby="any"
      aria-labelledby={`work-modal-title-${work.id}`}
    >
      <div class="work-modal__contents">
        <button
          class="work-modal__close"
          type="button"
          commandfor={`work-modal-${work.id}`}
          command="close"
          aria-label="閉じる"
        >
          <X size={32} stroke-width={0.5} />
        </button>

        <div class="work-modal__inner">
          <header class="work__header">
            <ul class="work__category">
              {work.data.category.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <h3 id={`work-modal-title-${work.id}`}>{work.data.title}</h3>
            {work.data.url && (
              <a
                class="work__url"
                href={work.data.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {work.data.url}
                <ExternalLink size={32} stroke-width={1} />
              </a>
            )}
            <p class="work__period">{work.data.period}</p>
          </header>

          <div class="work__meta">
            <div>
              <h4>担当領域</h4>
              <ul>
                {work.data.role.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div>
              <h4>使用技術</h4>
              <ul>
                {work.data.technologies.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>

          <div class="work__content">
            <Fragment set:html={html} />
          </div>
        </div>
      </div>
    </dialog>
  ))}
</section>

<style lang="scss">
  @use '../../styles/base' as *;
  @use '../../styles/breakpoints' as breakpoint;

  #works {
    h3 {
      margin-block: 1rem 0.5rem;
      // font-size: clamp(1rem, 3vw, 1.5rem);
      font-size: 1.25rem;

      @media (max-width: breakpoint.$mobile) {
        font-size: 1rem;
      }
    }

    h4 {
      margin: 0 0 0.5rem;
      font-size: 0.875rem;
    }

    .works-list {
      margin-top: 2rem;
      display: grid;
      gap: 2rem;
    }

    .work {
      position: relative;
      display: flex;
      flex-direction: row-reverse;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.5rem;
      border-radius: var(--radius-xl);
      background: var(--color-white);
      transition: background-color var(--transition-duration-normal) ease-in-out;

      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }

      @media (max-width: breakpoint.$mobile) {
        flex-direction: column;
      }

      &:hover,
      &:focus-within {
        background-color: var(--color-surface);

        .work__cta {
          background-color: var(--color-text);
          transform: translateY(-2px);

          svg {
            color: var(--color-white);
          }
        }
      }

      &__trigger {
        // カードの文書構造を保ち、独立したボタンで全体をクリック可能にする。
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        border-radius: inherit;
        color: inherit;
        background: transparent;
        cursor: pointer;

        &:focus-visible {
          outline: 2px solid var(--color-text);
          outline-offset: 4px;
        }
      }

      &__thumbnail {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 0 0 auto;
        width: 12rem;
        overflow: hidden;
        border: 1px solid var(--color-gray-100);
        border-radius: var(--radius-md);
        background-color: var(--color-surface);
        aspect-ratio: 16 / 9;

        @media (max-width: breakpoint.$mobile) {
          width: 100%;
        }

        img {
          display: block;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }

      &__placeholder {
        display: flex;
        justify-content: center;
        align-items: center;

        span {
          @extend .montserrat-500;
          font-size: 1.25rem;
          // text-transform: uppercase;
          letter-spacing: 0.05em;

          @media (max-width: breakpoint.$mobile) {
            font-size: 2rem;
          }
          &:nth-child(1) {
            color: var(--color-gray-300);
            text-transform: capitalize;
          }
          &:nth-child(2) {
            // color: var(--color-gray-200);
            background: linear-gradient(45deg, #6497fc 0%, #d01b63 100%);
            color: transparent;
            background-clip: text;
            text-fill-color: transparent;
          }
        }
      }

      &__body {
        display: block;
        flex: 1 1 auto;
        min-width: 0;
      }

      &__cta {
        --size: 40px;
        position: absolute;
        right: 0;
        bottom: 0;
        margin-top: 0.75rem;
        margin-right: calc(-1 * var(--size) / 6);
        margin-bottom: calc(-1 * var(--size) / 6);
        // padding: 0.5rem 0.875rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--size);
        height: var(--size);
        border-radius: var(--radius-infinite);
        background-color: var(--color-gray-100);
        box-shadow: var(--box-shadow-sm);
        transition:
          color var(--transition-duration-normal) ease,
          background-color var(--transition-duration-normal) ease,
          transform var(--transition-duration-normal) ease-in-out;

        svg {
          display: block;
          color: var(--color-gray-400);
          transition: color var(--color-transition-duration) ease;
        }
      }

      &__header {
        margin-bottom: 1.5rem;
      }

      &__period,
      &__url {
        font-size: var(--font-size-xs);
      }

      &__url {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        line-height: 1cap;

        svg {
          --size: 1.5em;
          block-size: var(--size);
          inline-size: var(--size);
        }

        + .work__period {
          margin-top: 0.5rem;
        }
      }

      &__category {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;

        li {
          display: inline-flex;
          align-items: center;
          gap: 0.375rem;
          padding: 0.1rem 0.625rem;
          font-size: var(--font-size-xxs);
          border: 1px solid var(--color-border);
          border-radius: var(--radius-sm);
          background-color: var(--color-white);
        }
      }

      &__meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
        padding-block: 1.25rem;
        border-block: 1px solid var(--color-border);

        @media (max-width: breakpoint.$mobile) {
          grid-template-columns: 1fr;
        }

        ul {
          margin: 0;
          padding: 0;
          list-style: none;
          font-size: 0.75rem;
        }

        li {
          &::before {
            content: '';
            display: inline-block;
            width: 0.5rem;
            height: 1px;
            margin-inline-end: 0.5rem;
            vertical-align: middle;
            background-color: var(--color-gray-400);
          }
        }
      }

      &__content {
        :global(h2) {
          margin-top: 2rem;
          font-size: 0.875rem;
        }
        :global(p) {
          font-size: 0.75rem;
          line-height: 1.8;
        }
      }
    }

    .work-modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      margin: auto;
      padding: 0;
      width: min(100% - 2rem, 40rem);
      // max-height: min(100% - 4rem, 48rem);
      max-height: 90vh;
      max-height: 90dvh;
      overscroll-behavior: contain;
      overflow: visible;
      border: 0;
      border-radius: var(--radius-xl);
      color: inherit;
      background: var(--color-white);
      box-shadow: 0 1.5rem 3rem rgb(15 23 42 / 24%);
      opacity: 0;
      transform: translateY(0.75rem) scale(0.97);
      transition:
        opacity var(--transition-duration-slow) ease,
        transform var(--transition-duration-slow) cubic-bezier(0.16, 1, 0.3, 1),
        overlay var(--transition-duration-slow) allow-discrete,
        display var(--transition-duration-slow) allow-discrete;

      &[open] {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      @starting-style {
        &[open] {
          opacity: 0;
          transform: translateY(0.75rem) scale(0.97);
        }
      }

      &::backdrop {
        background-color: rgb(15 23 42 / 55%);
        backdrop-filter: blur(2px);
        opacity: 0;
        transition:
          opacity var(--transition-duration-slow) ease,
          overlay var(--transition-duration-slow) allow-discrete,
          display var(--transition-duration-slow) allow-discrete;
      }

      &[open]::backdrop {
        opacity: 1;
      }

      @starting-style {
        &[open]::backdrop {
          opacity: 0;
        }
      }

      &__contents {
        max-height: 80vh;
        overflow-y: scroll;

        // max-height: inherit;
        // overflow-y: auto;
      }

      &__inner {
        position: relative;
        max-height: inherit;
        padding: 2rem;
        overflow-y: auto;
      }

      &__close {
        --size: 40px;
        position: absolute;
        top: 0;
        right: 0;
        margin-top: calc(-1 * var(--size) / 6);
        margin-right: calc(-1 * var(--size) / 6);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--size);
        height: var(--size);
        color: var(--color-text);
        border: 0;
        border-radius: var(--radius-infinite);
        background: var(--color-surface);
        box-shadow: var(--box-shadow-sm);
        cursor: pointer;
        z-index: 1;

        &:hover,
        &:focus-visible {
          background: var(--color-border);
        }
      }
    }
  }
</style>

<style lang="scss" is:global>
  :root:has(#works dialog:modal) {
    overflow: hidden;
  }
</style>
