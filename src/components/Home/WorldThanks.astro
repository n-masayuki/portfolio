<style lang="scss">
  @use '../../styles/base' as *;
  @use '../../styles/breakpoints' as breakpoint;

  .world-thanks {
    --wt-color: var(--color-text);

    display: grid;
    gap: 2rem;
    // padding-block: 4rem;
    padding-block: 4rem 6rem;
    text-align: center;

    :global(.world-thanks__message) {
      margin-inline: auto;
      padding-inline: 1.5rem;
      font-size: var(--font-size-xl);
      word-break: keep-all;

      // ハイドレーション前の分割前テキストが、分割・初期非表示化の直前に一瞬見えるのを防ぐ。
      @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
        &[data-split-pending] {
          visibility: hidden;
        }
      }
    }

    &__message {
      &-br {
        display: none;
      }

      &-sub {
        font-size: var(--font-size-xs);
        @media (max-width: breakpoint.$mobile) {
          display: none;
        }
      }
    }
  }
</style>
