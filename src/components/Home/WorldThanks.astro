<div class="world-thanks" data-world-thanks>
  <SplitText
    client:visible
    className="world-thanks__message"
    text="ご覧いただき<wbr />ありがとうございます。"
    effect="blur"
    splitType="chars"
    delay={80}
    duration={1.4}
    staggerFrom="start"
    trigger="view"
    hoverEffect="lift"
    loop
    loopDelay={1.5}
    mask={false}
    threshold={0.1}
    rootMargin="-40px"
    textAlign="center"
    onLetterAnimationComplete={handleAnimationComplete}
  />
