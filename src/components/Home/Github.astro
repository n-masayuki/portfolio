---
import { ExternalLink as ExternalLinkIcon } from '@lucide/astro';
import { siGithub } from 'simple-icons';
import ExternalLink from '../ui/ExternalLink.astro';
---

<section id="github" class="section github" aria-labelledby="github-heading">
  <h2 id="github-heading" class="visually-hidden">
    GitHub
  </h2>
  <ExternalLink
    class="github-link"
    href="https://github.com/n-masayuki"
    aria-label="GitHub"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d={siGithub.path} fill="currentColor" />
    </svg>
    View on GitHub
    <ExternalLinkIcon size={32} stroke-width={1} />
  </ExternalLink>
</section>

<style lang="scss">
  .github {
    padding-block: 3rem;
    display: flex;
    justify-content: center;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: var(--font-size-xxs);
    line-height: 1cap;
    text-decoration: none;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-infinite);
    background-color: var(--color-surface);

    &:hover {
      color: contrast-color(var(--color-text));
      border-color: contrast-color(var(--color-gray-200));
      background-color: contrast-color(var(--color-surface));
    }

    svg {
      --size: 1.5em;
      block-size: var(--size);
      inline-size: var(--size);
    }
  }
</style>
