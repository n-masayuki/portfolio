<section id="contact" class="section" aria-labelledby="contact-heading">
  <div class="section-heading">
    <div class="section-heading__ja-en-wrapper">
      <h2 id="contact-heading" class="section-heading__ja">
        お問い合わせ
      </h2>
      <p class="section-heading__en" aria-hidden="true">
        Contact
      </p>
    </div>
  </div>

  <p class="intro">以下のフォームからお気軽にご連絡ください。</p>

  <form class="contact-form" action="https://formspree.io/f/moevejjl" method="POST">
    <label for="contact-form-name">
      お名前 <span aria-hidden="true">※</span>
    </label>
    <input type="text" id="contact-form-name" name="name" autocomplete="name" maxlength="24" required />

    <label for="contact-form-email">
      メールアドレス <span aria-hidden="true">※</span>
    </label>
    <input type="email" id="contact-form-email" name="email" autocomplete="email" maxlength="254" required />

    <label for="contact-form-message">
      お問い合わせ内容 <span aria-hidden="true">※</span>
    </label>
    <textarea id="contact-form-message" name="message" maxlength="500" placeholder="500文字以内" required></textarea>

    <p class="character-count" aria-live="polite">
      <span id="contact-form-message-count">0</span> / 500文字
    </p>

    <p class="contact-form__note">
      <span aria-hidden="true">※</span>
      お問い合わせの内容によっては、お答えできない場合がございます。
    </p>

    <div
      class="cf-turnstile"
      data-sitekey="0x4AAAAAAE_YlR1gYvDPg5XU"
      data-action="contact"
      data-size="flexible"
      data-theme="light"
    ></div>

    <p class="contact-form__error" role="alert" id="contact-form-error"></p>
    <button type="submit">送信</button>
  </form>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const errorMessage = document.querySelector<HTMLElement>('#contact-form-error');

  if (form && submitButton && errorMessage) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitButton.disabled) return;

      const data = new FormData(form);
      errorMessage.textContent = '';
      submitButton.disabled = true;
      submitButton.textContent = '送信中…';
      form.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error('Form submission failed');

        window.location.assign('/contact/thanks/');
      } catch {
        errorMessage.textContent =
          '送信を完了できませんでした。通信環境や入力内容を確認し、認証後にもう一度送信してください。';
        // 再送時には、新しい Turnstile トークンを取得する。
        const turnstile = (window as Window & { turnstile?: { reset: (container: HTMLElement) => void } }).turnstile;
        const widget = form.querySelector<HTMLElement>('.cf-turnstile');
        if (turnstile && widget) turnstile.reset(widget);
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = '送信';
        form.removeAttribute('aria-busy');
      }
    });
  }

  // メッセージ入力欄の文字数をリアルタイムでカウントするためのスクリプト
  const message = document.querySelector<HTMLTextAreaElement>('#contact-form-message');
  const messageCount = document.querySelector<HTMLElement>('#contact-form-message-count');

  if (message && messageCount) {
    const updateMessageCount = () => {
      messageCount.textContent = String(Array.from(message.value).length);
    };

    message.addEventListener('input', updateMessageCount);
    updateMessageCount();
  }
</script>

