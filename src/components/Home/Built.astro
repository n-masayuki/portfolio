---
import type { ComponentProps } from 'astro/types';
import TechnologyList from '../ui/TechnologyList.astro';
import { siAstro, siReact, siTypescript, siGsap, siVite } from 'simple-icons';

type Skill = ComponentProps<typeof TechnologyList>['items'][number];

// Built With Skills
const builtWithSkills: Skill[] = [
  { icon: siAstro, label: 'Astro' },
  { icon: siVite, label: 'Vite' },
  { icon: siReact, label: 'React' },
  { icon: siTypescript, label: 'TypeScript' },
  { icon: siGsap, label: 'GSAP' },
  { label: 'etc.' },
];
---

<section id="built" class="section built">
  <p class="built__description">Built With:</p>
  <TechnologyList
    class="built-list"
    role="list"
    aria-label="使用技術"
    items={builtWithSkills}
  />
</section>

<style lang="scss">
  @use '../../styles/base' as *;
  @use '../../styles/breakpoints' as breakpoint;

  .built {
    margin-inline: auto;
    padding-block-start: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    place-items: center;
    gap: 0.5rem;
    width: fit-content;
    @media (max-width: breakpoint.$mobile) {
      place-items: center;
    }
  }

  .built__description {
    color: var(--color-text);
    font-size: var(--font-size-xs);
  }
</style>
