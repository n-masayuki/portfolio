---
import { siAstro, siReact, siTypescript, siGsap, siVite } from 'simple-icons';

type Skill = {
  label: string;
  icon?: {
    hex: string;
    path: string;
  };
};

// Built With Skills
const builtWithSkills: Skill[] = [
  { icon: siAstro, label: 'Astro' },
  { icon: siVite, label: 'Vite' },
  { icon: siReact, label: 'React' },
  { icon: siTypescript, label: 'TypeScript' },
  { icon: siGsap, label: 'GSAP' },
  { label: 'etc.' },
];
---

<section id="built" class="section built">
  <p class="built__description">Built With:</p>
  <ul class="built-list" role="list" aria-label="使用技術">
    {builtWithSkills.map(({ icon, label }) => (
      <li style={icon ? `--brand-color: #${icon.hex}` : undefined}>
        {icon && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={icon.path} fill="currentColor" />
          </svg>
        )}
        <span>{label}</span>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
  @use '../../styles/base' as *;
  @use '../../styles/breakpoints' as breakpoint;

  .built {
    margin-inline: auto;
    padding-block-start: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    place-items: center;
    gap: 0.5rem;
    width: fit-content;
    @media (max-width: breakpoint.$mobile) {
      place-items: center;
    }
  }

  .built__description {
    color: var(--color-text);
    font-size: var(--font-size-xs);
  }

  .built-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0.625rem;
      font-size: var(--font-size-xxs);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-infinite);
      color: var(--brand-color, var(--color-gray-600));
      background-color: var(--color-white);
    }

    svg {
      width: 1rem;
      height: 1rem;
    }

    span {
      color: var(--color-text);
    }
  }
</style>
