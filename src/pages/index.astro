---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Home/Hero.astro';
import About from '../components/Home/About.astro';
import Skills from '../components/Home/Skills.astro';
import WorksSection from '../components/Home/WorksSection.astro';
import Github from '../components/Home/Github.astro';
import Contact from '../components/Home/Contact.astro';

const works = (await getCollection('works')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout>
  <Hero />
  <About />
  <Skills />
  <WorksSection works={works} />
  <Github />
  <Contact />
</Layout>
