---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Splash from '../components/Home/Splash.astro';
// import Hero from '../components/Home/Hero.astro';
import About from '../components/Home/About.astro';
import Skills from '../components/Home/Skills.astro';
import WorksSection from '../components/Home/WorksSection.astro';
import Contact from '../components/Home/Contact.astro';
import Github from '../components/Home/Github.astro';
// import Built from '../components/Home/Built.astro';

// スプラッシュの切り替え: true = 有効、false = 無効（公開サイトへの反映には再ビルドが必要）。
const enableSplash = true;

const works = (await getCollection('works')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: 'Niibori Masayuki - Portfolio',
    description:
      'ポートフォリオサイト。ウェブ開発とデザインのスキルを紹介しています。',
    url: new URL(Astro.url.pathname, Astro.site).href,
    mainEntity: {
      '@type': 'Person',
      name: 'Niibori Masayuki',
      url: new URL('/', Astro.site).href,
    },
    hasPart: works.map((work) => ({
      '@type': 'CreativeWork',
      name: work.data.title,
      description: `${work.data.title}の制作実績。${work.data.category.join('、')}に関するポートフォリオです。`,
      creator: {
        '@type': 'Person',
        name: 'Niibori Masayuki',
      },
      temporalCoverage: work.data.period,
      keywords: [...work.data.category, ...work.data.technologies],
      ...(work.data.url ? { sameAs: work.data.url } : {}),
    })),
  }}
>
  <Fragment slot="splash">{enableSplash && <Splash />}</Fragment>
  {/* <Hero /> */}
  <About />
  <Skills />
  <WorksSection works={works} />
  <Contact />
  <Github />
  {/* <Built /> */}
</Layout>
