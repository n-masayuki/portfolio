---
import '../styles/global.scss';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="ポートフォリオサイト。ウェブ開発とデザインのスキルを紹介しています。"
    />
    <meta name="author" content="Niibori Masauyuki" />
    <meta name="theme-color" content="#ffffff" />
    <title>Niibori Masauyuki - Portfolio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Grape+Nuts&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style lang="scss">
  @use '../styles/base' as *;

  .site-shell {
    // @extend .pattern-bg;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    background-color: var(--color-background);

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      background-image: url(data:image/png;base64,);
      background-size: 256px 256px;
      opacity: 0.1;
    }

    &::after {
      content: '';
      position: fixed;
      // position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      background: linear-gradient(
        45deg,
        rgba(100, 151, 252, 0.2) 0%,
        rgba(255, 255, 255, 0) 20%,
        rgba(255, 255, 255, 0) 80%,
        rgba(208, 27, 99, 0.2) 100%
      );
      // background: linear-gradient(
      //   45deg,
      //   rgba(100, 151, 252, 0.2) 0%,
      //   rgba(255, 255, 255, 0) 6%,
      //   rgba(255, 255, 255, 0) 94%,
      //   rgba(208, 27, 99, 0.2) 100%
      // );
      pointer-events: none;
    }

    > * {
      position: relative;
      z-index: 1;
    }
  }

  // .pattern-bg {
  //   background-color: var(--color-background);
  //   background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.15' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.4'/%3E%3C/svg%3E");
  //   background-size: 200px 200px;
  // }

  .site-main {
    flex: 1;
  }
</style>
