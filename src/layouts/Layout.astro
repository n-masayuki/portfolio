---
import '../styles/global.scss';
import { getImage } from 'astro:assets';
import noiseSource from '../assets/noise.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ColorBends from '../components/ui/ColorBends.tsx';
import GoogleTagManager from '../components/GoogleTagManager.astro';

interface Props {
  title?: string;
  description?: string;
  pageUrl?: URL;
  ogImageUrl?: URL;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title = 'Niibori Masayuki - Portfolio',
  description = 'ポートフォリオサイト。ウェブ開発とデザインのスキルを紹介しています。',
  pageUrl = new URL(Astro.url.pathname, Astro.site),
  ogImageUrl = new URL('/ogp.png', Astro.site),
  noindex = false,
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl.href,
  },
} = Astro.props;

const noiseImage = await getImage({
  src: noiseSource,
  format: 'webp',
  quality: 10,
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <GoogleTagManager />
    <meta name="viewport" content="width=device-width" />
    {/* <meta name="robots" content="noindex, nofollow" /> */}
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content="Niibori Masayuki" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:alt" content="Niibori Masayukiのポートフォリオ" />
    <link rel="canonical" href={pageUrl.href} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
    <title>{title}</title>
    {/* <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> */}
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/grape-nuts-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/montserrat-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="preload" href={noiseImage.src} as="image" type="image/webp" />
  </head>
  <body>
    <GoogleTagManager noscript />
    <slot name="splash" />
    <div class="site-shell" style={`--noise-image: url("${noiseImage.src}")`}>
      <div class="color-bends-bg" aria-hidden="true">
        <ColorBends
          client:only="react"
          className="color-bends-canvas"
          colors={['#ffffff', '#d4d6ff']}
          rotation={90}
          speed={0.2}
          scale={1}
          frequency={1}
          warpStrength={1}
          mouseInfluence={1}
          noise={0.15}
          parallax={0.5}
          iterations={1}
          intensity={1.5}
          bandWidth={2}
          transparent
        />
      </div>
      <Header />
      <main class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  import { initAnchorScroll } from '../scripts/anchor-scroll';

  const cleanupAnchorScroll = initAnchorScroll();
  if (import.meta.hot) import.meta.hot.dispose(cleanupAnchorScroll);
  document.addEventListener('astro:before-swap', cleanupAnchorScroll, {
    once: true,
  });
</script>

<style lang="scss">
  @use '../styles/base' as *;

  .site-shell {
    // @extend .pattern-bg;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    background-color: var(--color-background);

    @keyframes noise {
      0% {
        background-position: 0 0;
      }
      100% {
        background-position: 64px 64px;
      }
    }

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      background-image: var(--noise-image);
      background-size: 256px 256px;
      opacity: 0.1;
      animation: noise 1s steps(4) infinite;
    }

    &::after {
      content: '';
      position: fixed;
      // position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      background: linear-gradient(
        45deg,
        rgba(100, 151, 252, 0.2) 0%,
        rgba(255, 255, 255, 0) 20%,
        rgba(255, 255, 255, 0) 80%,
        rgba(208, 27, 99, 0.2) 100%
      );
      pointer-events: none;
    }

    > * {
      position: relative;
      z-index: 1;
    }

    > .color-bends-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      width: 100%;
      height: 100%;
      container-type: size;
    }

    .color-bends-bg :global(.color-bends-container) {
      // 16:9の構図を保って画面を覆い、はみ出す部分は背景枠で切り抜く。
      position: absolute;
      top: 50%;
      left: 50%;
      width: max(100cqw, calc(100cqh * 16 / 9));
      height: auto;
      aspect-ratio: 16 / 9;
      transform: translate(-50%, -50%);
      overflow: hidden;
      opacity: 0.6;
    }
  }

  .site-main {
    flex: 1;
    overflow-y: clip;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // GSAPでスクロール位置をアニメーションの開始条件に使う
  gsap.registerPlugin(ScrollTrigger);

  // ユーザーが「動きの削減」を希望しているかどうかを判定する
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  // 共通見出しを取得し、画面に入ったときだけアニメーションする
  document
    .querySelectorAll<HTMLElement>('.section-heading__ja, .section-heading__en')
    .forEach((heading) => {
      if (prefersReducedMotion) return;

      const text = heading.textContent?.trim();
      if (!text) return;

      // 見出し全体の読み上げを残したまま、表示用の文字だけ分割する
      heading.setAttribute('aria-label', text);
      heading.textContent = '';

      // 各文字をspan要素に分割して、個別にアニメーションできるようにする
      const characters = [...text].map((character) => {
        const span = document.createElement('span');
        span.textContent = character;
        span.setAttribute('aria-hidden', 'true');
        heading.append(span);
        return span;
      });

      // アニメーション開始前は各文字を少し下げて非表示にする
      gsap.set(characters, {
        display: 'inline-block',
        opacity: 0,
        filter: 'blur(4px)',
        y: '0.6em',
      });

      // 見出しがビューポートに入ったら、文字を順番に表示する
      gsap.to(characters, {
        opacity: 1,
        y: 0,
        filter: 'blur(0px)',
        duration: 0.8,
        ease: 'power2.out',
        stagger: 0.06,
        scrollTrigger: {
          trigger: heading,
          start: 'top 89%',
          once: true,
          // markers: true,
        },
      });
    });

  // 要素を少し下からふわっと表示する
  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => {
    if (prefersReducedMotion) return;

    gsap.fromTo(
      element,
      { opacity: 0, y: 24, filter: 'blur(4px)' },
      {
        opacity: 1,
        y: 0,
        filter: 'blur(0px)',
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: element,
          start: 'top 92%',
          once: true,
          // markers: true,
        },
      },
    );
  });

  document.querySelectorAll<HTMLElement>('.world-thanks').forEach((section) => {
    if (prefersReducedMotion) return;

    gsap.fromTo(
      section,
      { opacity: 0, y: 24, filter: 'blur(4px)' },
      {
        opacity: 1,
        y: 0,
        filter: 'blur(0px)',
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 92%',
          once: true,
          // markers: true,
        },
      },
    );
  });
</script>
