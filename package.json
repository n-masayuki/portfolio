{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check --minimumFailingSeverity warning",
    "check:docs": "node scripts/check-docs.mjs",
    "check:static": "npm run check:docs && npm run check && npm run lint && npm run format:check",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "verify": "npm run check:static && npm run test:coverage && npm run test:e2e",
    "lighthouse": "npm run build && lhci autorun"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/react": "^7.1.0",
    "@gsap/react": "^2.1.2",
    "@lucide/astro": "^1.46.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.4.1",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-github-calendar": "^5.0.9",
    "simple-icons": "^16.31.0",
    "three": "^0.186.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tsconfig/bases": "^1.0.28",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "sass": "^1.104.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
